# PI05 project wrapper config for ${ACT_GRPO_ROOT:-/path/to/act-grpo}.
# Source this file before launching PI05 runs, or use scripts/run_pi05_smoke.sh.

ACT_GRPO_ROOT="${ACT_GRPO_ROOT:-/path/to/act-grpo}"
PI05_PROJECT_ROOT="${PI05_PROJECT_ROOT:-$ACT_GRPO_ROOT/pi05}"

PI_POLICY="${PI_POLICY:-pi05}"
PI05_PRETRAINED_PATH="${PI05_PRETRAINED_PATH:-$PI05_PROJECT_ROOT/models/pi05_base}"
PALIGEMMA_TOKENIZER_PATH="${PALIGEMMA_TOKENIZER_PATH:-$PI05_PROJECT_ROOT/tokenizer/paligemma-3b-pt-224}"

HF_HOME="${HF_HOME:-$ACT_GRPO_ROOT/hf_cache}"
HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
TRANSFORMERS_OFFLINE="${TRANSFORMERS_OFFLINE:-1}"
TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-false}"

PI_STEPS="${PI_STEPS:-1}"
PI_BATCH_SIZE="${PI_BATCH_SIZE:-1}"
PI_NUM_WORKERS="${PI_NUM_WORKERS:-0}"
PI_SAVE_FREQ="${PI_SAVE_FREQ:-1}"
PI_LOG_FREQ="${PI_LOG_FREQ:-1}"
PI_TOKENIZER_MAX_LENGTH="${PI_TOKENIZER_MAX_LENGTH:-200}"
