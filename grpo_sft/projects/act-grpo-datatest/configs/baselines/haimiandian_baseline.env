# Shell config for ACT/PI0 baselines on the copied haimiandian dataset.
# Source this file from bash scripts only.

ACT_GRPO_ROOT="${ACT_GRPO_ROOT:-/path/to/act-grpo}"
CONDA_ROOT="${CONDA_ROOT:-/path/to/miniconda3}"
ACT_GRPO_ENV="${ACT_GRPO_ENV:-$CONDA_ROOT/envs/act-grpo}"
LEROBOT_DIR="${LEROBOT_DIR:-$ACT_GRPO_ROOT/resources/lerobot}"
DATASET_ROOT="${DATASET_ROOT:-$ACT_GRPO_ROOT/resources/haimiandian_50}"
DATASET_REPO_ID="${DATASET_REPO_ID:-haimiandian}"

OUTPUT_BASE="${OUTPUT_BASE:-$ACT_GRPO_ROOT/results/baselines/haimiandian}"
LOG_BASE="${LOG_BASE:-$ACT_GRPO_ROOT/logs/baselines/haimiandian}"
HF_HOME="${HF_HOME:-$ACT_GRPO_ROOT/hf_cache}"

VIDEO_BACKEND="${VIDEO_BACKEND:-pyav}"
WANDB_ENABLE="${WANDB_ENABLE:-false}"
WANDB_PROJECT="${WANDB_PROJECT:-act_grpo_haimiandian_baselines}"
SEED="${SEED:-1000}"
CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"

ACT_STEPS="${ACT_STEPS:-5000}"
ACT_BATCH_SIZE="${ACT_BATCH_SIZE:-16}"
ACT_NUM_WORKERS="${ACT_NUM_WORKERS:-8}"
ACT_SAVE_FREQ="${ACT_SAVE_FREQ:-500}"
ACT_LOG_FREQ="${ACT_LOG_FREQ:-20}"
ACT_CHUNK_SIZE="${ACT_CHUNK_SIZE:-30}"
ACT_N_ACTION_STEPS="${ACT_N_ACTION_STEPS:-30}"
ACT_LR="${ACT_LR:-1e-5}"
ACT_PRETRAINED_BACKBONE_WEIGHTS="${ACT_PRETRAINED_BACKBONE_WEIGHTS:-null}"

PI_POLICY="${PI_POLICY:-pi0}"
PI_STEPS="${PI_STEPS:-1000}"
PI_BATCH_SIZE="${PI_BATCH_SIZE:-1}"
PI_NUM_WORKERS="${PI_NUM_WORKERS:-4}"
PI_SAVE_FREQ="${PI_SAVE_FREQ:-250}"
PI_LOG_FREQ="${PI_LOG_FREQ:-10}"
PI_CHUNK_SIZE="${PI_CHUNK_SIZE:-30}"
PI_N_ACTION_STEPS="${PI_N_ACTION_STEPS:-30}"
PI_DTYPE="${PI_DTYPE:-bfloat16}"
PI_LR="${PI_LR:-2.5e-5}"
PI_TOKENIZER_MAX_LENGTH="${PI_TOKENIZER_MAX_LENGTH:-128}"
PI_GRADIENT_CHECKPOINTING="${PI_GRADIENT_CHECKPOINTING:-true}"
PI_COMPILE_MODEL="${PI_COMPILE_MODEL:-false}"
PI_FREEZE_VISION_ENCODER="${PI_FREEZE_VISION_ENCODER:-true}"
PI_TRAIN_EXPERT_ONLY="${PI_TRAIN_EXPERT_ONLY:-true}"

# Set PI_PRETRAINED_PATH to a local directory when the model has been copied into act-grpo/resources.
# If left empty with ALLOW_RANDOM_INIT=1, train_pi0_bc_haimiandian.sh will run a random-init smoke/baseline.
PI0_PRETRAINED_PATH="${PI0_PRETRAINED_PATH:-$ACT_GRPO_ROOT/resources/models/pi0_base}"
PI05_PRETRAINED_PATH="${PI05_PRETRAINED_PATH:-lerobot/pi05_base}"
ALLOW_RANDOM_INIT="${ALLOW_RANDOM_INIT:-0}"
ALLOW_REMOTE_PRETRAINED="${ALLOW_REMOTE_PRETRAINED:-0}"
